{
  "name": "az-group-projects",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "AZ Group — витрина проектов компании",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file=.env.local server/dev.ts",
    "build": "tsc -b && vite build",
    "build:server": "esbuild server/node.ts scripts/create-admin.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outbase=. --outdir=dist-server --out-extension:.js=.mjs",
    "start": "node dist-server/server/node.mjs",
    "vercel-build": "node scripts/vercel-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local server/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.local server/db/seed.ts",
    "admin:create": "tsx --env-file=.env.local scripts/create-admin.ts"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vercel/node": "^24.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  }
}
