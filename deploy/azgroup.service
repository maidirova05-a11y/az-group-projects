[Unit]
Description=AZ Group site and API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=azgroup
WorkingDirectory=/opt/az-group
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
