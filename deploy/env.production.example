# Копируется на сервер как /opt/az-group-site/.env.production (chmod 600). Не коммитить с настоящими значениями.
NODE_ENV=production
PORT=3200
# База на этом же сервере (пароль выводит deploy/setup-server.sh)
DATABASE_URL=postgres://azgroup_site:ПАРОЛЬ_БД@127.0.0.1:5432/azgroup_site
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 16
IP_SALT=
# Перед Node стоит nginx, который сам выставляет X-Forwarded-For
TRUST_PROXY=1
# Только для первого запуска npm run admin:create:prod
ADMIN_EMAIL=
ADMIN_PASSWORD=
