# Секреты Docker-версии AZ Group (docs/SERVER.md).
#   cp docker.env.example docker.env
# docker.env в git не попадает. Значения — те же, что в Vercel → Settings →
# Environment Variables. Адрес базы задавать НЕ нужно: он прописан в compose.yaml.

# openssl rand -hex 32 — или тот же, что на Vercel (тогда админы останутся в системе).
JWT_SECRET=
# ⚠ Тот же, что на Vercel: иначе хэши IP в старых заявках и журнале входа не совпадут с новыми.
IP_SALT=
