# PostgreSQL. Локально — отдельный кластер на 5433 (npm run db:start).
# На Vercel — строка подключения Neon/Supabase/любого Postgres (лучше pooled).
DATABASE_URL=postgres://postgres@localhost:5433/azgroup
# Для тестов
TEST_DATABASE_URL=postgres://postgres@localhost:5433/azgroup_test
# Секрет подписи сессий админки: минимум 32 случайных символа (например, `openssl rand -hex 32`).
# Значение с «change-me» сервер отклонит — замените его.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars
# Соль для хэша IP (заявки, журнал входа). Обязательна в production; локально по умолчанию 'dev-salt'.
IP_SALT=change-me
# 1 — доверять X-Forwarded-For (только если перед Node стоит свой reverse-proxy). На Vercel не нужно:
# там IP берётся из x-vercel-forwarded-for / x-real-ip.
# TRUST_PROXY=1
# Первый администратор (npm run admin:create)
ADMIN_EMAIL=admin@az-group.kz
ADMIN_PASSWORD=
